{
  "$comment": "漂移治理 v2 组件 B — Codex hooks 模板。放置于目标 workspace 的 .codex/hooks.json（项目级）或 ~/.codex/hooks.json（用户级）。格式与 Claude Code 完全一致（嵌套 hooks + hookSpecificOutput 协议），直接复用 claude-code 适配器下的共享脚本。Codex 文件编辑走 apply_patch 工具（guard 已支持从 patch 文本解析路径）；matcher 是正则（Bash / apply_patch / Edit|Write）。首次启用需在 Codex 里运行 /hooks 审查并信任。{TOOLS} 替换为 tools 包所在目录的绝对路径（正斜杠）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS}/tools/skills/shared/crctl/adapters/claude-code/hooks/inject-cr-status.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS}/tools/skills/shared/crctl/adapters/claude-code/hooks/inject-cr-status.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS}/tools/skills/shared/crctl/adapters/claude-code/hooks/pretooluse-guard.mjs\""
          }
        ]
      }
    ]
  }
}