{
  "$comment": "漂移治理 v2 组件 B — Claude Code hooks 模板。把 hooks 段合并进目标 workspace 的 .claude/settings.json（团队共享）或 settings.local.json（个人）。{TOOLS_ROOT} 安装时物化为 tools 包绝对路径（来源 dir-graph.yaml#workspace.tools_package_path）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS_ROOT}/skills/shared/crctl/adapters/claude-code/hooks/pretooluse-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS_ROOT}/skills/shared/crctl/adapters/claude-code/hooks/pretooluse-guard.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS_ROOT}/skills/shared/crctl/adapters/claude-code/hooks/inject-cr-status.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS_ROOT}/skills/shared/crctl/adapters/claude-code/hooks/inject-cr-status.mjs\""
          }
        ]
      }
    ]
  }
}
