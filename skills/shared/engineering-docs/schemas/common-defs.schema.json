{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-first-rd-platform/skills/engineering-docs/common-defs.schema.json",
  "title": "Common definitions for engineering docs frontmatter",
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "deprecated"]
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^v\\d+(?:\\.\\d+)*(?:-[a-z0-9]+)?$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 48
    },
    "docId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Za-z0-9.]+)+$"
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream": {
          "type": "array",
          "items": { "type": "string" }
        },
        "downstream": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["upstream", "downstream"]
    },
    "baseFrontmatter": {
      "type": "object",
      "required": ["id", "type", "name", "title", "status", "owner", "created", "updated", "refs"],
      "properties": {
        "id": { "$ref": "#/definitions/docId" },
        "type": { "type": "string" },
        "name": { "$ref": "#/definitions/slug" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" },
        "owner": { "type": "string", "minLength": 1 },
        "created": { "$ref": "#/definitions/isoDate" },
        "updated": { "$ref": "#/definitions/isoDate" },
        "version": { "$ref": "#/definitions/semver" },
        "refs": { "$ref": "#/definitions/refs" }
      }
    }
  }
}
