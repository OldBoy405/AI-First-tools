{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-first-rd-platform/skills/engineering-docs/module.schema.json",
  "title": "MODULE frontmatter",
  "allOf": [
    { "$ref": "https://ai-first-rd-platform/skills/engineering-docs/common-defs.schema.json#/definitions/baseFrontmatter" },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "pattern": "^MODULE-\\d{3}$" },
        "type": { "const": "MODULE" },
        "behaviors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "openapi-ref": { "type": "string" }
      }
    }
  ]
}
