{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-first-rd-platform/skills/engineering-docs/task.schema.json",
  "title": "TASK frontmatter",
  "allOf": [
    { "$ref": "https://ai-first-rd-platform/skills/engineering-docs/common-defs.schema.json#/definitions/baseFrontmatter" },
    {
      "type": "object",
      "required": ["type", "version", "task-of"],
      "properties": {
        "id": { "pattern": "^TASK-v\\d+(?:\\.\\d+)*(?:-[a-z0-9]+)?-\\d{3}-\\d{2}$" },
        "type": { "const": "TASK" },
        "version": { "$ref": "https://ai-first-rd-platform/skills/engineering-docs/common-defs.schema.json#/definitions/semver" },
        "task-of": { "type": "string", "pattern": "^PLAN-v\\d+(?:\\.\\d+)*(?:-[a-z0-9]+)?-\\d{3}$" },
        "branch": { "type": "string" },
        "pr": { "type": "string" }
      }
    }
  ]
}
