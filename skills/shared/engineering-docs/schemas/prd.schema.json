{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-first-rd-platform/skills/engineering-docs/prd.schema.json",
  "title": "PRD frontmatter",
  "allOf": [
    { "$ref": "https://ai-first-rd-platform/skills/engineering-docs/common-defs.schema.json#/definitions/baseFrontmatter" },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "pattern": "^PRD-\\d{3}$" },
        "type": { "const": "PRD" },
        "fr-list": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  ]
}
