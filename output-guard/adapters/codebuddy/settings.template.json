{
  "$comment": "CodeBuddy Code hooks 模板（OutputGuard）。多 scope 合并生效：<project-root>/.codebuddy/settings.json（可提交）/ .codebuddy/settings.local.json / ~/.codebuddy/settings.json。{TOOLS_ROOT} 安装时物化为绝对路径。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS_ROOT}/output-guard/adapters/codebuddy/pretooluse-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{TOOLS_ROOT}/output-guard/adapters/codebuddy/posttooluse-guard.mjs\""
          }
        ]
      }
    ]
  }
}
